{%if settings.dgHomeLink === true%}
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/" style="text-decoration: none;">
        {% if meta.siteLogoPath %}
          <img class="site-logo" src="{{meta.siteLogoPath}}" alt="{{meta.siteName}}">
        {% else %}
          <h1 style="margin: 15px !important;">{{meta.siteName}}</h1>
        {% endif %}
      </a>

      <!-- Home button cố định -->
      <a href="/" style="
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(147, 112, 219, 0.18);
        color: #C084C8;
        border: 1px solid rgba(192, 132, 200, 0.4);
        border-radius: 999px;
        padding: 5px 14px;
        font-size: 0.85rem;
        text-decoration: none;
        transition: all 0.2s;
      "
      onmouseover="this.style.color='#5DD4E8';this.style.borderColor='rgba(93,212,232,0.5)'"
      onmouseout="this.style.color='#C084C8';this.style.borderColor='rgba(192,132,200,0.4)'"
      >
        🏡 Home
      </a>

      {% if settings.dgEnableSearch === true%}
        {% include "components/searchButton.njk" %}
      {%endif%}
    </div>
  </nav>
{%else%}
  <div class="empty-navbar" >
    {% if settings.dgEnableSearch === true%}
      {% include "components/searchButton.njk" %}
    {%endif%}
  </div>
{%endif%}
