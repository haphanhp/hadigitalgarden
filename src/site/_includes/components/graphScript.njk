<script src="https://unpkg.com/3d-force-graph@1/dist/3d-force-graph.min.js"></script>

<script type="module">
import { forceSimulation, forceManyBody, forceCenter, forceLink, forceCollide, forceRadial } from 'd3-force';
import { select } from 'd3-selection';
import { zoom as d3Zoom, zoomIdentity } from 'd3-zoom';
import { drag as d3Drag } from 'd3-drag';

// Pixi v7 loaded as UMD global
const { Application, Container, Graphics, Text, Circle } = PIXI;

async function fetchGraphData() {
    const graphData = await fetch('/graph.json').then(res => res.json());
    const fullGraphData = filterFullGraphData(graphData);
    return { graphData, fullGraphData };
}

function filterFullGraphData(graphData) {
    if (!graphData) return null;
    graphData = JSON.parse(JSON.stringify(graphData));
    const hiddens = Object.values(graphData.nodes).filter(n => n.hide).map(n => n.id);
    return {
        links: graphData.links.filter(l => hiddens.indexOf(l.source) === -1 && hiddens.indexOf(l.target) === -1),
        nodes: Object.values(graphData.nodes).filter(n => !n.hide),
    };
}

function filterLocalGraphData(graphData) {
    if (!graphData) return null;
    const allNodes = JSON.parse(JSON.stringify(graphData.nodes));
    const allLinks = JSON.parse(JSON.stringify(graphData.links));
    let currentLink = decodeURI(window.location.pathname);

    let currentNode = allNodes[currentLink];
    if (!currentNode) {
        const lower = currentLink.toLowerCase();
        currentNode = Object.values(allNodes).find(v => v.url.toLowerCase() === lower);
    }
    if (!currentNode) {
        currentNode = Object.values(allNodes).find(v => v.home);
    }
    if (!currentNode) return null;

    currentNode.current = true;

    const neighbourhood = new Set();
    neighbourhood.add(currentNode.url);
    if (currentNode.neighbors) {
        currentNode.neighbors.forEach(n => neighbourhood.add(n));
    }

    const nodes = Object.values(allNodes).filter(n => {
        if (n.hide) return false;
        return neighbourhood.has(n.url);
    });

    if (!currentNode.home && currentNode.neighbors) {
        const homeNode = nodes.find(n => n.home);
        if (homeNode && !currentNode.neighbors.includes(homeNode.url)) {
            const idx = nodes.indexOf(homeNode);
            if (idx > -1) nodes.splice(idx, 1);
        }
    }

    const ids = nodes.map(n => n.id);
    return {
        nodes,
        links: allLinks.filter(l => ids.indexOf(l.target) > -1 && ids.indexOf(l.source) > -1),
    };
}

function getCssVar(variable) {
    return getComputedStyle(document.body).getPropertyValue(variable).trim();
}

const _colorProbe = document.createElement('div');
_colorProbe.style.display = 'none';
document.body.appendChild(_colorProbe);
function resolveColor(cssValue) {
    _colorProbe.style.color = cssValue;
    const resolved = getComputedStyle(_colorProbe).color;
    const match = resolved.match(/(\d+),\s*(\d+),\s*(\d+)/);
    if (match) {
        return (parseInt(match[1]) << 16) + (parseInt(match[2]) << 8) + parseInt(match[3]);
    }
    return 0x666666;
}

const _decodeEl = document.createElement('textarea');
function htmlDecode(input) {
    _decodeEl.innerHTML = input;
    return _decodeEl.value;
}

function buildDegreeMap(links) {
    const degrees = {};
    for (const l of links) {
        const sid = typeof l.source === 'object' ? l.source.id : l.source;
        const tid = typeof l.target === 'object' ? l.target.id : l.target;
        degrees[sid] = (degrees[sid] || 0) + 1;
        degrees[tid] = (degrees[tid] || 0) + 1;
    }
    return degrees;
}

function nodeRadius(nodeId, degreeMap) {
    return 5 + Math.sqrt(degreeMap[nodeId] || 0) * 1.5;
}

function drawNode(gfx, r, nodeColor, isHovered, glowColor) {
    gfx.clear();
    if (isHovered) {
        gfx.lineStyle(2.5, 0xffffff, 0.6);
        gfx.drawCircle(0, 0, r + 5);
        gfx.lineStyle(1.5, glowColor, 0.9);
        gfx.drawCircle(0, 0, r + 2.5);
    }
    gfx.beginFill(nodeColor, 1);
    gfx.drawCircle(0, 0, r);
    gfx.endFill();
    gfx.lineStyle(1, 0xffffff, 0.3);
    gfx.drawCircle(0, 0, r);
}

function renderGraph(graphData, containerId, isFullScreen) {
    if (!graphData || !graphData.nodes || graphData.nodes.length === 0) return null;

    const el = document.getElementById(containerId);
    if (!el) return null;

    while (el.firstChild) el.removeChild(el.firstChild);

    const width = el.offsetWidth;
    const height = el.offsetWidth || 400;
    if (width === 0) return null;

    const color = resolveColor(getCssVar('--dg-graph-node-color') || getCssVar('--graph-main') || '#C084C8');
    const mutedColor = resolveColor(getCssVar('--dg-graph-node-color-muted') || getCssVar('--graph-muted') || '#5DD4E8');
    const textColor = resolveColor(getCssVar('--dg-graph-label-color') || getCssVar('--text-normal') || '#eee');
    const bodyFont = getComputedStyle(document.body).fontFamily || 'Sans-Serif';

    const degreeMap = buildDegreeMap(graphData.links);

    const nodes = graphData.nodes.map(n => ({ ...n, text: htmlDecode(n.title) }));
    const links = graphData.links.map(l => ({ source: l.source, target: l.target }));

    const chargeStrength = isFullScreen ? -300 : -120;
    const linkDist = isFullScreen ? 80 : 50;
    const radius = Math.min(width, height) / 3;
    const simulation = forceSimulation(nodes)
        .force('charge', forceManyBody().strength(chargeStrength))
        .force('center', forceCenter(width / 2, height / 2).strength(0.5))
        .force('link', forceLink(links).id(d => d.id).distance(linkDist))
        .force('collide', forceCollide(d => nodeRadius(d.id, degreeMap) + 2).iterations(3))
        .force('radial', forceRadial(radius, width / 2, height / 2).strength(0.05));

    const app = new Application({
        width, height,
        antialias: true, autoStart: false, autoDensity: true,
        backgroundAlpha: 0,
        resolution: window.devicePixelRatio,
    });
    el.appendChild(app.view);

    const stage = app.stage;
    stage.interactive = true;
    stage.hitArea = app.screen;

    const linkGfx = new Graphics();
    const nodesContainer = new Container();
    const labelsContainer = new Container();
    stage.addChild(linkGfx, nodesContainer, labelsContainer);

    let hoveredNodeId = null;
    let hoveredNeighbours = new Set();
    let dragging = false;
    let dragStartTime = 0;
    let dragStartPos = null;
    let currentTransform = zoomIdentity;

    const nodeRenderData = [];
    const linkRenderData = [];

    function updateHoverInfo(newId) {
        hoveredNodeId = newId;
        hoveredNeighbours.clear();

        if (newId === null) {
            for (const n of nodeRenderData) {
                n.active = false;
                const nodeColor = n.simulationData.current ? color : mutedColor;
                drawNode(n.gfx, n.radius, nodeColor, false, color);
            }
            for (const l of linkRenderData) l.active = false;
        } else {
            for (const l of linkRenderData) {
                const src = l.simulationData.source;
                const tgt = l.simulationData.target;
                const srcId = typeof src === 'object' ? src.id : src;
                const tgtId = typeof tgt === 'object' ? tgt.id : tgt;
                if (srcId === newId || tgtId === newId) {
                    hoveredNeighbours.add(srcId);
                    hoveredNeighbours.add(tgtId);
                }
                l.active = srcId === newId || tgtId === newId;
            }
            for (const n of nodeRenderData) {
                n.active = hoveredNeighbours.has(n.simulationData.id);
                const nodeColor = n.simulationData.current ? color : mutedColor;
                const isHovered = n.simulationData.id === newId;
                drawNode(n.gfx, n.radius, nodeColor, isHovered, color);
            }
        }
    }

    for (const n of nodes) {
        const r = nodeRadius(n.id, degreeMap);
        const label = new Text(n.text, {
            fontSize: 22, fill: textColor, fontFamily: bodyFont, fontWeight: 'bold',
            dropShadow: true, dropShadowColor: '#000000', dropShadowBlur: 4, dropShadowDistance: 1,
        });
        label.resolution = 2;
        label.anchor.set(0.5, 1);
        label.scale.set(1 / 3);
        label.alpha = 0.85;

        const gfx = new Graphics();
        gfx.interactive = true;
        gfx.cursor = 'pointer';
        gfx.hitArea = new Circle(0, 0, r + 4);
        gfx._nodeId = n.id;

        const nodeColor = n.current ? color : mutedColor;
        drawNode(gfx, r, nodeColor, false, color);

        gfx.on('pointerover', () => {
            updateHoverInfo(gfx._nodeId);
            label.alpha = 1;
            if (!dragging) updateVisuals();
        });
        gfx.on('pointerleave', () => {
            updateHoverInfo(null);
            label.alpha = 0.85;
            if (!dragging) updateVisuals();
        });

        nodesContainer.addChild(gfx);
        labelsContainer.addChild(label);
        nodeRenderData.push({ simulationData: n, gfx, label, radius: r, active: false, baseAlpha: 1, targetAlpha: 1, currentAlpha: 1 });
    }

    for (const l of links) {
        linkRenderData.push({ simulationData: l, active: false, baseAlpha: 0.4, targetAlpha: 0.4, currentAlpha: 0.4 });
    }

    function updateVisuals() {
        for (const n of nodeRenderData) {
            n.targetAlpha = hoveredNodeId !== null ? (n.active ? 1 : 0.2) : n.baseAlpha;
        }
        for (const l of linkRenderData) {
            l.targetAlpha = hoveredNodeId !== null ? (l.active ? 0.9 : 0.05) : l.baseAlpha;
        }
    }

    function lerp(a, b, t) { return a + (b - a) * t; }

    select(app.view).call(
        d3Drag()
            .container(() => app.view)
            .subject(() => {
                if (!hoveredNodeId) return null;
                const node = nodes.find(n => n.id === hoveredNodeId);
                if (!node) return null;
                return { x: node.x * currentTransform.k + currentTransform.x, y: node.y * currentTransform.k + currentTransform.y, node };
            })
            .on('start', function (event) {
                if (!event.active) simulation.alphaTarget(1).restart();
                const node = event.subject.node;
                node.fx = node.x; node.fy = node.y;
                dragStartTime = Date.now();
                dragStartPos = { x: event.x, y: event.y };
                dragging = true;
            })
            .on('drag', function (event) {
                const node = event.subject.node;
                node.fx = (event.x - currentTransform.x) / currentTransform.k;
                node.fy = (event.y - currentTransform.y) / currentTransform.k;
            })
            .on('end', function (event) {
                if (!event.active) simulation.alphaTarget(0);
                const node = event.subject.node;
                node.fx = null; node.fy = null;
                dragging = false;
                const dt = Date.now() - dragStartTime;
                const dx = event.x - dragStartPos.x;
                const dy = event.y - dragStartPos.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dt < 500 && dist < 5 && node.url) window.location = node.url;
            })
    );

    const zoomBehavior = d3Zoom()
        .extent([[0, 0], [width, height]])
        .scaleExtent([0.25, 4])
        .on('zoom', ({ transform }) => {
            currentTransform = transform;
            stage.scale.set(transform.k, transform.k);
            stage.position.set(transform.x, transform.y);
            const scaleOpacity = Math.min(0.85 + (transform.k - 1) / 4, 1);
            for (const n of nodeRenderData) {
                if (n.simulationData.id !== hoveredNodeId) n.label.alpha = scaleOpacity;
            }
        });
    select(app.view).call(zoomBehavior);

    let stopAnimation = false;
    const smoothing = 0.15;

    function animate() {
        if (stopAnimation) return;
        for (const n of nodeRenderData) {
            const { x, y } = n.simulationData;
            if (x == null || y == null) continue;
            n.gfx.position.set(x, y);
            n.label.position.set(x, y - n.radius - 4);
            n.currentAlpha = lerp(n.currentAlpha, n.targetAlpha, smoothing);
            n.gfx.alpha = n.currentAlpha;
            if (n.simulationData.id === hoveredNodeId) n.label.alpha = 1;
        }
        linkGfx.clear();
        for (const l of linkRenderData) {
            const src = l.simulationData.source;
            const tgt = l.simulationData.target;
            if (src.x == null || tgt.x == null) continue;
            l.currentAlpha = lerp(l.currentAlpha, l.targetAlpha, smoothing);
            linkGfx.lineStyle(1.5, l.active ? color : mutedColor, l.currentAlpha);
            linkGfx.moveTo(src.x, src.y);
            linkGfx.lineTo(tgt.x, tgt.y);
        }
        app.render();
        requestAnimationFrame(animate);
    }
    requestAnimationFrame(animate);

    if (isFullScreen || graphData.nodes.length > 4) {
        setTimeout(() => {
            let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
            for (const n of nodes) {
                if (n.x == null || n.y == null) continue;
                minX = Math.min(minX, n.x); maxX = Math.max(maxX, n.x);
                minY = Math.min(minY, n.y); maxY = Math.max(maxY, n.y);
            }
            if (minX === Infinity) return;
            const padding = 50;
            const gw = (maxX - minX) + padding * 2;
            const gh = (maxY - minY) + padding * 2;
            const k = Math.min(width / gw, height / gh, 2);
            const cx = (minX + maxX) / 2;
            const cy = (minY + maxY) / 2;
            const transform = zoomIdentity.translate(width / 2 - cx * k, height / 2 - cy * k).scale(k);
            select(app.view).call(zoomBehavior.transform, transform);
        }, 500);
    }

    return function cleanup() {
        stopAnimation = true;
        simulation.stop();
        select(app.view).on('.drag', null).on('.zoom', null);
        app.destroy(true, { children: true });
    };
}

// ─── Colour helpers ───────────────────────────────────────────────────────────
function hexToRgb(hex) {
    const n = parseInt(hex.replace('#',''), 16);
    return { r: (n>>16)&255, g: (n>>8)&255, b: n&255 };
}
function hslToHex(h, s, l) {
    s /= 100; l /= 100;
    const a = s * Math.min(l, 1 - l);
    const f = n => {
        const k = (n + h / 30) % 12;
        const c = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
        return Math.round(255 * c).toString(16).padStart(2, '0');
    };
    return `#${f(0)}${f(8)}${f(4)}`;
}
function hexAlpha(hex, alpha) {
    const { r, g, b } = hexToRgb(hex);
    return `rgba(${r},${g},${b},${alpha})`;
}

// ─── Hue từ group hoặc URL path ──────────────────────────────────────────────
// Dùng golden-angle hash → màu trải đều, không đụng nhau
function hashStringToHue(str) {
    let h = 0;
    for (let i = 0; i < str.length; i++) h = (Math.imul(31, h) + str.charCodeAt(i)) | 0;
    return ((h >>> 0) * 137.508) % 360;
}

// Lấy color key từ URL — dùng segment cấp 2 (folder chính trong vault)
// /700-vaults/750-movie/vietnam-movie/...              → "750-movie"
// /700-vaults/710-research/713-politic-history-vietnam/... → "710-research"
// /1000-distillations/1000-4-published/ha-digital-garden/ → "1000-4-published"
// /                                                    → "home"
// Logic: cấp 2 đủ ổn định — thêm folder mới trong tương lai tự ra màu mới
// Cấp 3 quá chi tiết (nhiều màu na ná), cấp 1 quá chung (ít màu)
function urlColorKey(url) {
    if (!url || url === '/') return 'home';
    const parts = url.replace(/^\//, '').replace(/\/$/, '').split('/').filter(Boolean);
    // Segment thứ 2 nếu có, không thì segment cuối
    if (parts.length >= 2) return parts[1];
    return parts[0] || 'home';
}

// Màu theo tag: dùng phần cha nếu có '/' để group sub-tags cùng màu
// tech/automation, tech/ai, tech/tool → đều ra màu "tech"
// make-money/affiliate, make-money/gig → đều ra màu "make-money"
// learning, adhd, moc → dùng nguyên tag
function nodeHue(node) {
    if (node.tags && node.tags.length > 0) {
        const tag = node.tags[0].toLowerCase();
        const key = tag.includes('/') ? tag.split('/')[0] : tag;
        return hashStringToHue(key);
    }
    return hashStringToHue(urlColorKey(node.url || node.id || ''));
}

// ─── Tính màu node — "dải sao" ───────────────────────────────────────────────
//   Hue   = group/path  →  màu phân biệt từng nhóm
//   L     = 30%(leaf) → 75%(hub)   node trung tâm sáng hơn
//   alpha = 0.15(leaf) → 1.0(hub)  node ngoài rìa mờ như sao xa
function nodeStarColor(node, degree, maxDegree) {
    const hue = nodeHue(node);
    const t   = maxDegree > 0 ? Math.sqrt(degree / maxDegree) : 0;
    const sat   = 88;
    const light = Math.round(30 + t * 47);
    const alpha = 0.15 + t * 0.85;
    return { hex: hslToHex(hue, sat, light), alpha, hue, t };
}

// ─── 3D Graph — Starfield Edition ────────────────────────────────────────────
function render3DGraph(graphData, containerId) {
    if (!graphData || !graphData.nodes || graphData.nodes.length === 0) return null;
    const el = document.getElementById(containerId);
    if (!el) return null;
    while (el.firstChild) el.removeChild(el.firstChild);

    const degreeMap = buildDegreeMap(graphData.links);
    const maxDegree = Math.max(...Object.values(degreeMap), 1);

    // Build node list với màu tag + brightness theo degree
    const nodes = graphData.nodes.map(n => {
        const deg  = degreeMap[n.id] || 0;
        const { hex, alpha, t } = nodeStarColor(n, deg, maxDegree); // truyền đúng object n

        return {
            id:    n.id,
            name:  n.title || n.id,
            url:   n.url,
            tags:  n.tags || [],
            hex,                            // full-brightness hex (dùng cho glow/particles)
            color: hexAlpha(hex, alpha),    // màu thực render (mờ/sáng theo degree)
            val:   Math.max(0.5, deg * 0.8 + 1),  // size theo degree
            brightness: t,                  // 0→1, dùng cho link opacity
        };
    });

    const nodeMap = Object.fromEntries(nodes.map(n => [n.id, n]));
    const links   = graphData.links.map(l => ({ source: l.source, target: l.target }));

    // ── THREE.js custom node: sphere + sprite glow ──────────────────────────
    // (ForceGraph3D expose THREE globally)
    const THREE = window.THREE;

    const Graph = ForceGraph3D()(el)
        .width(el.clientWidth)
        .height(el.clientHeight)
        .graphData({ nodes, links })
        .backgroundColor('#0a0a0f')          // nền vũ trụ tối
        .showNavInfo(false)

        // ── Nodes ──
        .nodeLabel(node => {
            const tagStr = node.tags && node.tags.length > 0
                ? `<div style="margin-top:4px;opacity:0.75;font-size:11px">${node.tags.map(t => '#'+t).join(' ')}</div>`
                : '';
            return `<div style="background:rgba(0,0,0,0.75);padding:6px 10px;border-radius:6px;border:1px solid ${node.hex};font-size:13px;color:#fff;max-width:200px">
                <b>${node.name}</b>${tagStr}
            </div>`;
        })
        .nodeVal('val')
        .nodeResolution(16)
        .nodeOpacity(1)                      // opacity quản lý qua color alpha
        .nodeColor('color')

        // Glow sprite cho hub nodes (brightness > 0.5)
        .nodeThreeObject(node => {
            if (!THREE || node.brightness < 0.3) return null; // leaf: dùng default sphere

            const group = new THREE.Group();

            // Sphere chính
            const r    = Math.cbrt(node.val) * 4;
            const geo  = new THREE.SphereGeometry(r, 16, 16);
            const mat  = new THREE.MeshLambertMaterial({
                color: new THREE.Color(node.hex),
                transparent: true,
                opacity: node.brightness,
            });
            group.add(new THREE.Mesh(geo, mat));

            // Glow halo (sprite) — chỉ cho hub thật sự
            if (node.brightness > 0.6) {
                const spriteMat = new THREE.SpriteMaterial({
                    color: new THREE.Color(node.hex),
                    transparent: true,
                    opacity: node.brightness * 0.35,
                    blending: THREE.AdditiveBlending,
                    depthWrite: false,
                });
                const sprite = new THREE.Sprite(spriteMat);
                const glowSize = r * (3 + node.brightness * 5);
                sprite.scale.set(glowSize, glowSize, 1);
                group.add(sprite);
            }

            return group;
        })
        .nodeThreeObjectExtend(false)

        // ── Links ──
        .linkColor(link => {
            const src = typeof link.source === 'object' ? link.source : nodeMap[link.source];
            const tgt = typeof link.target === 'object' ? link.target : nodeMap[link.target];
            if (!src || !tgt) return 'rgba(100,100,120,0.1)';
            // Màu link = blend hue source + brightness của 2 đầu
            const avgBrightness = (src.brightness + tgt.brightness) / 2;
            return hexAlpha(src.hex, Math.max(0.04, avgBrightness * 0.3));
        })
        .linkWidth(link => {
            const src = typeof link.source === 'object' ? link.source : nodeMap[link.source];
            return src && src.brightness > 0.5 ? 0.6 : 0.2;
        })

        // Particles chỉ chạy trên link giữa các hub
        .linkDirectionalParticles(link => {
            const src = typeof link.source === 'object' ? link.source : nodeMap[link.source];
            const tgt = typeof link.target === 'object' ? link.target : nodeMap[link.target];
            if (!src || !tgt) return 0;
            return (src.brightness + tgt.brightness) > 1.0 ? 2 : 0;
        })
        .linkDirectionalParticleSpeed(0.003)
        .linkDirectionalParticleWidth(1.2)
        .linkDirectionalParticleColor(link => {
            const src = typeof link.source === 'object' ? link.source : nodeMap[link.source];
            return src ? src.hex : '#ffffff';
        })

        .onNodeClick(node => { if (node.url) window.location = node.url; })
        .onNodeHover(node => {
            el.style.cursor = node ? 'pointer' : 'default';
            // Highlight node được hover — làm sáng lên
            Graph.nodeColor(n => {
                if (!node) return n.color;
                if (n.id === node.id) return n.hex; // full brightness
                // neighbour nodes
                const isNeighbour = graphData.links.some(l => {
                    const s = typeof l.source === 'object' ? l.source.id : l.source;
                    const t = typeof l.target === 'object' ? l.target.id : l.target;
                    return (s === node.id && t === n.id) || (t === node.id && s === n.id);
                });
                return isNeighbour ? hexAlpha(n.hex, 0.9) : hexAlpha(n.hex, 0.15);
            });
        });

    // Thêm ambient light nhẹ để sphere không bị tối hoàn toàn
    if (THREE) {
        const scene = Graph.scene();
        scene.add(new THREE.AmbientLight(0x333355, 1.2));
        const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
        dirLight.position.set(1, 1, 1);
        scene.add(dirLight);
    }

    const onResize = () => { Graph.width(el.clientWidth).height(el.clientHeight); };
    window.addEventListener('resize', onResize);

    return function cleanup() {
        window.removeEventListener('resize', onResize);
        if (Graph._destructor) Graph._destructor();
        while (el.firstChild) el.removeChild(el.firstChild);
    };
}

// ─── State ───────────────────────────────────────────────────────────────────
let graphDataCache    = null;
let fullGraphDataCache = null;
let localGraphCleanup  = null;
let globalGraphCleanup = null;
let currentModalData   = null;
let currentMode        = '3d'; // 3D mặc định

async function init() {
    const { graphData, fullGraphData } = await fetchGraphData();
    graphDataCache     = graphData;
    fullGraphDataCache = fullGraphData;
    renderLocal();
}

function renderLocal() {
    if (localGraphCleanup) { localGraphCleanup(); localGraphCleanup = null; }
    const data = filterLocalGraphData(graphDataCache);
    localGraphCleanup = renderGraph(data, 'link-graph', false);
}

// ─── Mode toggle ─────────────────────────────────────────────────────────────
function setMode(mode) {
    currentMode = mode;

    const btn2d = document.getElementById('graph-mode-2d');
    const btn3d = document.getElementById('graph-mode-3d');
    if (btn2d && btn3d) {
        const active   = 'background:var(--dg-graph-node-color,#C084C8);color:#fff;';
        const inactive = 'background:rgba(255,255,255,0.12);color:rgba(255,255,255,0.75);';
        btn2d.style.cssText = btn2d.style.cssText.replace(/background[^;]+;color[^;]+;/, mode === '2d' ? active : inactive);
        btn3d.style.cssText = btn3d.style.cssText.replace(/background[^;]+;color[^;]+;/, mode === '3d' ? active : inactive);
    }

    if (globalGraphCleanup) { globalGraphCleanup(); globalGraphCleanup = null; }

    if (mode === '3d') {
        globalGraphCleanup = render3DGraph(currentModalData, 'full-graph-container');
    } else {
        globalGraphCleanup = renderGraph(currentModalData, 'full-graph-container', true);
        lucide.createIcons({ attrs: { class: ['svg-icon'] } });
    }
}

function openModal(data) {
    currentModalData = data;
    if (globalGraphCleanup) { globalGraphCleanup(); globalGraphCleanup = null; }
    document.getElementById('full-graph').style.display = '';
    setTimeout(() => {
        setMode(currentMode);
        lucide.createIcons({ attrs: { class: ['svg-icon'] } });
    }, 50);
}

function openFullGraph()    { openModal(fullGraphDataCache); }
function openExpandedLocal(){ openModal(filterLocalGraphData(graphDataCache)); }

function closeFullGraph() {
    document.getElementById('full-graph').style.display = 'none';
    if (globalGraphCleanup) { globalGraphCleanup(); globalGraphCleanup = null; }
}

window.__graph = { openFullGraph, closeFullGraph, openExpandedLocal, rerenderLocal: renderLocal, setMode };

document.addEventListener('forestry:css-changed', () => { if (graphDataCache) renderLocal(); });

init();
</script>

<div id="graph-component" class="graph" x-data="{ showFullGraph: false }">
    <div class="graph-title-container">
        <div class="graph-title">Connected Pages</div>
        <div id="graph-controls">
            <div class="ctrl-right">
                <span id="global-graph-btn" x-on:click="showFullGraph = true; window.__graph.openFullGraph()"><i data-lucide="globe" aria-hidden="true"></i></span>
                <span id="graph-fs-btn" x-on:click="showFullGraph = true; window.__graph.openExpandedLocal()"><i data-lucide="expand" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
    <div id="link-graph"></div>

    <div x-show="showFullGraph" id="full-graph" class="show" style="display: none;" x-on:click.self="window.__graph.closeFullGraph(); showFullGraph = false;">

        <!-- Nút đóng -->
        <span id="full-graph-close" x-on:click="window.__graph.closeFullGraph(); showFullGraph = false;"><i data-lucide="x" aria-hidden="true"></i></span>

        <!-- Toggle 2D / 3D -->
        <div style="position:absolute;top:1rem;left:50%;transform:translateX(-50%);z-index:10;display:flex;gap:6px;background:rgba(0,0,0,0.35);padding:4px;border-radius:10px;backdrop-filter:blur(8px);">
            <button id="graph-mode-2d"
                onclick="window.__graph.setMode('2d')"
                style="padding:5px 18px;border-radius:7px;border:none;cursor:pointer;font-size:13px;font-weight:600;transition:all .2s;background:rgba(255,255,255,0.12);color:rgba(255,255,255,0.75);">
                2D
            </button>
            <button id="graph-mode-3d"
                onclick="window.__graph.setMode('3d')"
                style="padding:5px 18px;border-radius:7px;border:none;cursor:pointer;font-size:13px;font-weight:600;transition:all .2s;background:var(--dg-graph-node-color,#C084C8);color:#fff;">
                3D
            </button>
        </div>

        <div id="full-graph-container"></div>
    </div>
</div>
