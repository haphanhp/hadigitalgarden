STYLE_SETTINGS_CSS=body.css-settings-manager { --tag-radius: 2em; --anp-cursor: pointer; --anp-editor-font-source: ""; --anp-editor-font-lp: ""; --bold-weight: 700; --anp-font-live-preview-wt: 400; --h1-weight: 700; --h2-weight: 700; --h3-weight: 700; --h4-weight: 700; --h5-weight: 700; --h6-size: 1.1em; --h6-weight: 700; --anp-colorful-frame-opacity: 1; --anp-file-label-align: 0; --anp-rainbow-folder-bg-opacity: 0.9; --anp-depth-tab-opacity: 0.6; --anp-depth-tab-gap: 10px; } body.theme-light.css-settings-manager { --ctp-custom-peach: 221,127,103; --ctp-custom-teal: 24,190,220; --ctp-custom-subtext1: 238,101,58; --ctp-custom-subtext0: 12,159,206; --ctp-custom-overlay2: 53,53,53; --ctp-custom-overlay1: 190,118,86; --ctp-custom-overlay0: 98,209,148; --ctp-custom-surface2: 224,63,63; } body.theme-dark.css-settings-manager { --ctp-custom-teal: 17,183,197; --ctp-custom-subtext0: 251,53,216; --ctp-custom-overlay2: 10,209,208; --ctp-custom-overlay1: 255,166,0; --ctp-custom-overlay0: 76,255,210; }
STYLE_SETTINGS_BODY_CLASSES=mod-windows is-frameless is-hidden-frameless obsidian-app styled-scrollbars theme-light show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header css-settings-manager ctp-rosepine-light ctp-frappe ctp-accent-light-teal ctp-accent-teal anuppuccin-accent-toggle anp-no-highlight anp-callout-sleek anp-callout-color-toggle anp-custom-checkboxes anp-speech-bubble anp-latex-inline-text anp-latex-block-text anp-td-none anp-color-transition-toggle anp-hide-external-link-icon anp-header-color-toggle anp-header-divider-color-toggle anp-h1-red anp-h2-peach anp-h3-green anp-h4-teal anp-h5-lavender anp-h6-mauve anp-decoration-toggle anp-bold-red anp-italic-green anp-highlight-yellow anp-colorful-frame anp-file-icons anp-collapse-folders anp-full-rainbow-color-toggle anp-simple-rainbow-title-toggle anp-simple-rainbow-indentation-toggle anp-safari-tab-toggle anp-safari-tab-animated anp-border-layout outliner-plugin-dnd highlightr-realistic AT-row is-focused
